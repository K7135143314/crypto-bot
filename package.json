{
  "name": "dex-arbitrage-scanner",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Read-only Base DEX-to-DEX arbitrage scanner prototype",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "scan": "tsx src/index.ts",
    "compare": "tsx src/compare-scans.ts",
    "history": "tsx src/analyze-history.ts",
    "test": "tsx --test src/profit.test.ts src/history.test.ts src/rolling-history.test.ts src/paper.test.ts src/atomic-preflight.test.ts src/scout.test.ts src/scout-verifier.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "proof:candidate": "tsx src/candidate-proof.ts",
    "paper": "tsx src/analyze-paper-persistence.ts",
    "test:atomic-preflight": "tsx --test src/atomic-preflight.test.ts",
    "simulation:plan": "tsx src/simulation-plan.ts",
    "simulation:compare": "tsx src/compare-simulation.ts",
    "scout": "tsx src/scout-cli.ts",
    "verify:scout": "tsx src/scout-verifier-cli.ts",
    "central-history": "tsx src/update-central-history.ts",
    "intelligence-history": "tsx src/update-intelligence-history.ts"
  },
  "dependencies": {
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
