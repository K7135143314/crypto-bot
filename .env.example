# Optional. Put any preferred Base RPC URLs first, comma-separated.
# The scanner also falls back to PublicNode, 1RPC, and Base's public RPC.
BASE_RPC_URLS=https://base-rpc.publicnode.com,https://public.1rpc.io/base,https://mainnet.base.org

# Comma-separated starting USDC amounts to test.
TRADE_SIZES_USDC=100,250,500,1000,2500,5000,10000

# Illustrative executor gas-use scenarios only. These are not proven transaction gas.
GAS_UNIT_SCENARIOS=300000,500000,800000
